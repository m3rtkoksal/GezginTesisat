rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sadece e-postası doğrulanmış yönetici içeriği değiştirebilir. Diğer koleksiyonlar (leads, usage...) sadece sunucudan.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "umitkurt360@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

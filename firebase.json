{
  "hosting": {
    "site": "su-tesisat-site-mk",
    "public": ".",
    "ignore": [
      "firebase.json",
      "*.rules",
      "firestore.indexes.json",
      "**/.*",
      "functions/**",
      "*.template.html"
    ],
    "rewrites": [
      {
        "source": "/",
        "function": {
          "functionId": "site",
          "region": "europe-west1"
        }
      },
      {
        "source": "/index.html",
        "function": {
          "functionId": "site",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/rewrite",
        "function": {
          "functionId": "rewrite",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/quote",
        "function": {
          "functionId": "quote",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/adminSetup",
        "function": {
          "functionId": "adminSetup",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}